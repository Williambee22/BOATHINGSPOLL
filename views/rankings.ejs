<%- include('partials/header') %>

<section class="section rankings-page">

  <div class="shell">

    <div class="page-head">

      <div>

        <div class="eyebrow">
          YOUR CURRENT BALLOT
        </div>

        <h1>
          My Top <%= requiredCount %>
        </h1>

        <p>
          Build your current Top <%= requiredCount %>,
          then drag and drop the ranked rows into the exact
          order you want. Saving replaces your previous
          ballot and immediately updates the composite.
        </p>

        <% if (updatedAt) { %>

          <p class="last-saved">

            Last saved

            <time
              data-local-datetime="<%= new Date(updatedAt).toISOString() %>"
            >
              <%= new Date(updatedAt).toISOString() %>
            </time>

          </p>

        <% } %>

      </div>

      <a
        class="text-link"
        href="/"
      >
        View composite →
      </a>

    </div>


    <% if (!bands.length) { %>

      <div class="empty-state bordered">

        <strong>
          No bands have been added yet.
        </strong>

        <span>
          The administrator can add or bulk-import
          the national band list.
        </span>

      </div>

    <% } else { %>

      <form
        method="post"
        action="/rankings"
      >

        <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
        >

        <input
          type="hidden"
          name="rankings_json"
          id="rankingsJson"
          value="[]"
        >

        <div
          class="ballot-builder"
          data-rank-builder
          data-required-count="<%= requiredCount %>"
          data-draft-key="mbpoll:rankings:draft:<%= currentUser.id %>"
          data-server-rankings='<%- JSON.stringify(rankingIds) %>'
        >

          <section class="picker-panel">

            <div class="picker-head">

              <div>

                <div class="eyebrow">
                  ELIGIBLE BANDS
                </div>

                <h2>
                  Band list
                </h2>

              </div>

              <span class="count-chip">

                <span id="selectedCount">
                  <%= rankingIds.length %>
                </span>

                /<%= requiredCount %>

              </span>

            </div>


            <div class="search-wrap">

              <input
                type="search"
                id="bandSearch"
                placeholder="Search school or state..."
                autocomplete="off"
              >

              <div
                class="search-status"
                id="bandSearchStatus"
                aria-live="polite"
              ></div>

            </div>


            <div
              class="band-pool"
              id="bandPool"
            >

              <% bands.forEach(band => { %>

                <button
                  type="button"
                  class="band-option <%= rankingIds.includes(Number(band.id)) ? 'is-selected' : '' %>"
                  data-band-id="<%= band.id %>"
                  data-band-name="<%= band.name %>"
                  data-location="<%= [band.city, band.state].filter(Boolean).join(', ') %>"
                >

                  <span>

                    <strong>
                      <%= band.name %>
                    </strong>

                    <small>
                      <%= [band.city, band.state].filter(Boolean).join(', ') || 'Location not listed' %>
                    </small>

                  </span>

                  <span class="plus">
                    +
                  </span>

                </button>

              <% }) %>


              <div
                class="band-search-empty"
                id="bandSearchEmpty"
                hidden
              >
                No matching bands.
              </div>

            </div>

          </section>


          <section class="picker-panel ranked-panel">

            <div class="picker-head">

              <div>

                <div class="eyebrow">
                  YOUR ORDER
                </div>

                <h2>
                  Top <%= requiredCount %>
                </h2>

              </div>

              <span class="drag-note">
                Drag to reorder
              </span>

            </div>


            <ol
              class="rank-list"
              id="rankList"
            >

              <%
                rankingIds.forEach(id => {

                  const band = bands.find(
                    b => Number(b.id) === Number(id)
                  );

                  if (band) {
              %>

                <li
                  class="rank-item"
                  draggable="true"
                  data-band-id="<%= band.id %>"
                  data-band-name="<%= band.name %>"
                  data-location="<%= [band.city, band.state].filter(Boolean).join(', ') %>"
                >

                  <span class="rank-number"></span>

                  <span
                    class="grip"
                    title="Drag to reorder"
                    aria-label="Drag to reorder"
                  >
                    ⋮⋮
                  </span>

                  <span class="rank-copy">

                    <strong>
                      <%= band.name %>
                    </strong>

                    <small>
                      <%= [band.city, band.state].filter(Boolean).join(', ') || 'Location not listed' %>
                    </small>

                  </span>

                  <button
                    type="button"
                    class="remove-band"
                    aria-label="Remove <%= band.name %>"
                  >
                    ×
                  </button>

                </li>

              <%
                  }
                });
              %>

            </ol>


            <div class="save-box">

              <div class="save-tools">

                <button
                  type="button"
                  class="plain-button"
                  id="clearRankings"
                >
                  Clear all
                </button>

              </div>

              <p id="rankMessage"></p>

              <button
                class="button button-full"
                id="saveRankings"
                type="submit"
              >
                Save rankings
              </button>

              <small>
                Saving replaces your previous ballot;
                it does not add a second vote.
              </small>

              <small
                id="draftStatus"
                aria-live="polite"
              ></small>

            </div>

          </section>

        </div>

      </form>

    <% } %>

  </div>

</section>

<%- include('partials/footer') %>
