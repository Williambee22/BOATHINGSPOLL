<%- include('partials/header') %>
<section class="section admin-page">
  <div class="shell">
    <div class="page-head">
      <div><div class="eyebrow">ADMINISTRATION</div><h1>Poll control</h1><p>Manage the eligible bands, homepage graphic title, accounts, and stale ballots.</p></div>
      <div class="admin-head-actions"><a class="button" href="/rankings">Cast / edit my vote</a><a class="text-link" href="/">View public rankings →</a></div>
    </div>

    <section class="admin-panel full-panel" id="graphic-title">
      <div class="panel-head">
        <div><div class="eyebrow">TOP 25 GRAPHIC</div><h2>Homepage graphic title</h2></div>
      </div>
      <form method="post" action="/admin/settings/graphic-title" class="week-setting-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Graphic title
          <input type="text" name="graphic_title" maxlength="100" value="<%= graphicTitle %>" placeholder="BOA THINGS TOP 25 WEEK 4" required>
        </label>
        <p>This is only the headline shown on the large homepage graphic. It does not create weeks, reset ballots, or change how voting works.</p>
        <button class="button" type="submit">Update graphic title</button>
      </form>
    </section>

    <div class="admin-grid" id="bands">
      <section class="admin-panel">
        <div class="panel-head"><div><div class="eyebrow">ADD ONE</div><h2>Add a band</h2></div></div>
        <form method="post" action="/admin/bands" class="stack-form compact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>School / band name<input name="name" required></label>
          <div class="two-fields"><label>City<input name="city"></label><label>State<input name="state" maxlength="40"></label></div>
          <button class="button" type="submit">Add band</button>
        </form>
      </section>

      <section class="admin-panel">
        <div class="panel-head"><div><div class="eyebrow">BULK IMPORT</div><h2>Paste a full list</h2></div></div>
        <form method="post" action="/admin/bands/import" class="stack-form compact-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>One band per line<textarea name="band_list" rows="8" placeholder="Noblesville H.S., IN&#10;Norton H.S., OH&#10;Norwood H.S., OH&#10;O'Fallon Township H.S., IL&#10;Pike County Central H.S., KY"></textarea></label>
          <small>Use <strong>School Name, ST</strong>. Duplicate school/state entries are ignored; the first occurrence is kept.</small>
          <button class="button" type="submit">Import bands</button>
        </form>
      </section>
    </div>

    <section class="admin-panel full-panel" id="band-list">
      <div class="panel-head"><div><div class="eyebrow">ELIGIBLE LIST</div><h2>Bands</h2></div><span class="count-chip"><%= bands.filter(b => b.active).length %> active</span></div>
      <% if (!bands.length) { %><div class="empty-state"><span>No bands have been added yet.</span></div><% } else { %>
        <div class="table-wrap"><table><thead><tr><th>Band</th><th>Location</th><th>Mentions</th><th>Status</th><th></th></tr></thead><tbody>
          <% bands.forEach(band => { %><tr class="<%= band.active ? '' : 'inactive-row' %>">
            <td><strong><%= band.name %></strong></td>
            <td><%= [band.city, band.state].filter(Boolean).join(', ') || '—' %></td>
            <td><%= band.ranking_mentions %></td>
            <td><span class="status <%= band.active ? 'status-active' : 'status-inactive' %>"><%= band.active ? 'Active' : 'Inactive' %></span></td>
            <td class="actions-cell"><form method="post" action="/admin/bands/<%= band.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="plain-button" type="submit"><%= band.active ? 'Deactivate' : 'Activate' %></button></form></td>
          </tr><% }) %>
        </tbody></table></div>
      <% } %>
    </section>

    <section class="admin-panel full-panel" id="accounts">
      <div class="panel-head"><div><div class="eyebrow">BALLOTS & ACCOUNTS</div><h2>Members</h2></div><span class="count-chip"><%= accounts.length %> accounts</span></div>
      <% if (!accounts.length) { %><div class="empty-state"><span>No accounts yet.</span></div><% } else { %>
        <div class="table-wrap"><table class="account-admin-table"><thead><tr><th>Name</th><th>Username</th><th>Ballot</th><th>Last updated</th><th>Status</th><th>Ballot control</th><th>Reset password</th><th>Account</th></tr></thead><tbody>
          <% accounts.forEach(account => { %><tr class="<%= account.active ? '' : 'inactive-row' %>">
            <td><strong><%= account.display_name %></strong><% if (account.is_admin) { %><span class="role-tag">Admin</span><% } %></td>
            <td>@<%= account.username %></td>
            <td><%= account.has_ballot ? `${account.ranked_count} ranked` : 'None' %></td>
            <td>
              <% if (account.updated_at) { %>
                <time data-local-datetime="<%= new Date(account.updated_at).toISOString() %>"><%= new Date(account.updated_at).toISOString() %></time>
              <% } else { %>—<% } %>
            </td>
            <td><span class="status <%= account.active ? 'status-active' : 'status-inactive' %>"><%= account.active ? 'Active' : 'Inactive' %></span></td>
            <td>
              <% if (account.has_ballot) { %>
                <form method="post" action="/admin/users/<%= account.id %>/delete-ballot" data-confirm="Delete this saved ranking? It will immediately stop counting in the composite.">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="danger-link" type="submit">Delete ballot</button>
                </form>
              <% } else { %><span class="muted-dash">—</span><% } %>
            </td>
            <td>
              <% if (!account.is_admin) { %>
                <form method="post" action="/admin/users/<%= account.id %>/reset-password" class="inline-reset"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="password" name="password" minlength="10" placeholder="Temporary password" required><button class="plain-button" type="submit">Reset</button></form>
              <% } else { %><span class="muted-dash">Use Account page</span><% } %>
            </td>
            <td>
              <% if (!account.is_admin) { %>
                <form method="post" action="/admin/users/<%= account.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="plain-button" type="submit"><%= account.active ? 'Deactivate' : 'Activate' %></button></form>
              <% } else { %><span class="muted-dash">Protected</span><% } %>
            </td>
          </tr><% }) %>
        </tbody></table></div>
      <% } %>
    </section>
  </div>
</section>
<%- include('partials/footer') %>
