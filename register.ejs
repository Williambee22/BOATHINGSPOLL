<%- include('partials/header') %>
<section class="auth-section">
  <div class="shell auth-grid">
    <div class="auth-copy">
      <div class="eyebrow">JOIN THE POLL</div>
      <h1>Create an account. That’s it.</h1>
      <p>No separate voter registration or approval step. Once your account is created, you can rank the eligible bands immediately.</p>
    </div>
    <div class="form-card">
      <h2>Create account</h2>
      <form method="post" action="/register" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Display name<input name="display_name" maxlength="100" autocomplete="name" required></label>
        <label>Username<input name="username" minlength="3" maxlength="64" autocomplete="username" required></label>
        <label>Password<input type="password" name="password" minlength="10" autocomplete="new-password" required></label>
        <label>Confirm password<input type="password" name="confirm_password" minlength="10" autocomplete="new-password" required></label>
        <button class="button button-full" type="submit">Create account</button>
      </form>
      <p class="form-footer">Already registered? <a href="/login">Sign in</a>.</p>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
